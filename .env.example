# ===========================================
# Workforce Intelligence Platform - Environment Configuration
# ===========================================

# Application
APP_NAME="Workforce Intelligence Platform"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/workforce_intelligence
# For SQLite (development fallback):
DATABASE_URL=sqlite+aiosqlite:///./workforce_intelligence.db

# PostgreSQL (Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=workforce_intelligence
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws
VITE_USE_MOCK=true
VITE_APP_NAME="Workforce Intelligence"

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Logging
LOG_LEVEL=INFO
